import tkinter as tk
from tkinter import ttk, scrolledtext
import socket
import threading
from cryptography.hazmat.primitives import serialization, hashes
from cryptography.hazmat.primitives.asymmetric import rsa, padding

# Глобальные настройки
HOST = "127.0.0.1"
PORT = 12345

# -------------------- Server GUI --------------------
class ServerApp(tk.Toplevel):
    def __init__(self):
        super().__init__()
        self.title("Сервер")
        self.geometry("500x400")
        
        # Генерация ключей
        self.private_key = rsa.generate_private_key(
            public_exponent=65537,
            key_size=2048
        )
        self.public_key = self.private_key.public_key()
        
        # Элементы интерфейса
        self.status_label = ttk.Label(self, text="Статус: Остановлен", foreground="red")
        self.start_button = ttk.Button(self, text="Запустить сервер", command=self.start_server)
        self.log_area = scrolledtext.ScrolledText(self, state='disabled')
        
        # Размещение элементов
        self.status_label.pack(pady=10)
        self.start_button.pack(pady=5)
        self.log_area.pack(pady=10, fill=tk.BOTH, expand=True)
        
        self.server_socket = None
        self.is_running = False

    def start_server(self):
        if not self.is_running:
            self.server_thread = threading.Thread(target=self._run_server, daemon=True)
            self.server_thread.start()
            self.is_running = True
            self.status_label.config(text="Статус: Запущен", foreground="green")
            self.start_button.config(text="Остановить сервер")
        else:
            self.is_running = False
            if self.server_socket:
                self.server_socket.close()
            self.status_label.config(text="Статус: Остановлен", foreground="red")
            self.start_button.config(text="Запустить сервер")

    def _run_server(self):
        self.server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server_socket.bind((HOST, PORT))
        self.server_socket.listen(1)
        
        while self.is_running:
            try:
                client_socket, addr = self.server_socket.accept()
                threading.Thread(target=self._handle_client, args=(client_socket,), daemon=True).start()
            except:
                break

    def _handle_client(self, client_socket):
        try:
            encrypted_data = client_socket.recv(4096)
            decrypted_data = self.private_key.decrypt(
                encrypted_data,
                padding.OAEP(
                    mgf=padding.MGF1(algorithm=hashes.SHA256()),
                    algorithm=hashes.SHA256(),
                    label=None
                )
            )
            self._update_log(f"Получено от {client_socket.getpeername()}: {decrypted_data.decode()}")
        except Exception as e:
            self._update_log(f"Ошибка: {str(e)}")
        finally:
            client_socket.close()

    def _update_log(self, message):
        self.log_area.config(state='normal')
        self.log_area.insert(tk.END, message + "\n")
        self.log_area.config(state='disabled')

# -------------------- Client GUI --------------------
class ClientApp(tk.Toplevel):
    def __init__(self, server_public_key):
        super().__init__()
        self.title("Клиент")
        self.geometry("400x300")
        self.server_public_key = server_public_key
        
        # Элементы интерфейса
        self.message_entry = ttk.Entry(self, width=40)
        self.send_button = ttk.Button(self, text="Отправить", command=self.send_message)
        self.status_label = ttk.Label(self, text="Не подключен", foreground="red")
        
        # Размещение элементов
        self.message_entry.pack(pady=10)
        self.send_button.pack(pady=5)
        self.status_label.pack(pady=5)

    def send_message(self):
        message = self.message_entry.get()
        if message:
            threading.Thread(target=self._send_data, args=(message,), daemon=True).start()

    def _send_data(self, message):
        try:
            client_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            client_socket.connect((HOST, PORT))
            encrypted = self.server_public_key.encrypt(
                message.encode(),
                padding.OAEP(
                    mgf=padding.MGF1(algorithm=hashes.SHA256()),
                    algorithm=hashes.SHA256(),
                    label=None
                )
            )
            client_socket.send(encrypted)
            self.status_label.config(text="Сообщение отправлено!", foreground="green")
        except Exception as e:
            self.status_label.config(text=f"Ошибка: {str(e)}", foreground="red")
        finally:
            client_socket.close()
            self.after(2000, lambda: self.status_label.config(text="Не подключен", foreground="red"))

# -------------------- Main Application --------------------
class MainApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Secure Chat")
        self.geometry("300x100")
        
        ttk.Button(self, text="Открыть сервер", command=self.open_server).pack(pady=10)
        ttk.Button(self, text="Открыть клиент", command=self.open_client).pack(pady=10)
        
        self.server_app = None
        self.client_app = None

    def open_server(self):
        if not self.server_app or not self.server_app.winfo_exists():
            self.server_app = ServerApp()

    def open_client(self):
        if self.server_app and self.server_app.winfo_exists():
            public_key = self.server_app.public_key
            self.client_app = ClientApp(public_key)
        else:
            tk.messagebox.showerror("Ошибка", "Сервер не запущен!")

if __name__ == "__main__":
    app = MainApp()
    app.mainloop()
